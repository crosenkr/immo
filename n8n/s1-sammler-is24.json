    {
      "parameters": {
        "jsCode": "// Mailabschluss vorbereiten: UIDs aller in diesem Lauf verarbeiteten ImmoScout-Mails,\n// ohne die Mails, die eine Stoerung ausgeloest haben (die gehen nach Immo/DLQ).\nconst alle = $('Felder angleichen').all().map(i => i.json.uid).filter(u => Number.isFinite(u));\nlet stoer = [];\ntry { stoer = $('Hash und Zustand').all().filter(i => i.json.stoerung).map(i => i.json.mail_uid).filter(u => Number.isFinite(u)); } catch (e) {}\nconst ok = Array.from(new Set(alle.filter(u => !stoer.includes(u))));\nconst dlq = Array.from(new Set(stoer));\nif (!ok.length && !dlq.length) return [];\nreturn [{ json: { uids: ok, uid_list: ok.join(','), dlq_uids: dlq, dlq_list: dlq.join(',') } }];\n"
      },
