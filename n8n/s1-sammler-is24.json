      "id": "d67e6c83-b985-4083-8a72-af92bfdfcc14",
      "name": "IS24-Mail parsen",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Aenderungs-Hash je Anzeige (FNV-1a 32 Bit ueber die typisierten Felder), fuer PREIS_RUNTER / PREIS_RAUF ab Phase 2\nconst raus = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (j.stoerung) { raus.push(item); continue; }\n  if (!j.objekt_schluessel) { raus.push({ json: { objekt_schluessel: 'kein_objekt', leer: true } }); continue; }   // Leerlauf: nur Kontomails, Mailabschluss soll trotzdem laufen\n  const s = [j.titel, j.kaufpreis_eur, j.wohnflaeche_qm, j.zimmer, j.strasse, j.hausnummer, j.stadtteil].join('|');\n  let h = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }\n  j.roh_block_sha256 = null; j.roh_block_hash = h.toString(16).padStart(8, '0');\n  for (const k of ['kaufpreis_eur','wohnflaeche_qm','zimmer','grundstueck_qm','preis_je_qm','provision_kaeufer_pct']) { if (typeof j[k] !== 'number') j[k] = null; }  // Zahlenspalten: 'fehlt in der Anzeige' wird null (R6-Zustand steht in belege)\n  j.erfasst_am = new Date().toISOString();\n  j.zustand = 'neu';                                                  // Zustandsmodell K2: neu -> bewertet -> ...\n  j.belege = JSON.stringify(j.belege); j.merkmale = JSON.stringify(j.merkmale);\n  raus.push({ json: j });\n}\nreturn raus;\n"
      },
