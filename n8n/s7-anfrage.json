      "id": "a1",
      "name": "Alle 2 Minuten"
    },
    {
      "parameters": {
        "jsCode": "// S7 Anfrage, Schritt 1: Abrufmarke lesen.\n// Telegram liefert bei getUpdates nur Nachrichten ab der Marke (offset). Die Marke steht im\n// dauerhaften Speicher des Workflows, damit jede Nachricht genau einmal verarbeitet wird.\nconst sd = $getWorkflowStaticData('global');\nif (typeof sd.offset !== 'number') sd.offset = 0;\nreturn [{ json: { offset: sd.offset } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1300,
        300
      ],
      "id": "a2",
      "name": "Abrufmarke lesen"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/botHIER_DEIN_BOT_TOKEN/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $json.offset }}"
            },
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\"]"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1100,
        300
      ],
      "id": "a3",
      "name": "Telegram abfragen",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// S7 Anfrage, Schritt 2: Anfragen erkennen.\n// Eingabe: Antwort von getUpdates. Ausgabe: ein Item je gewuenschtem Exposé, jedes mit der hoechsten Update-Nummer.\n// Nur Nachrichten aus dem eigenen Chat zaehlen (R19: keine fremden Absender).\n// Die Marke steht nicht mehr im Arbeitsspeicher: der Knoten \"Marke bestaetigen\" meldet sie am Ende an Telegram zurueck.\nconst CHAT_ID = 884133793;\nconst raus = [];\nlet hoechste = 0;\nfor (const i of $input.all()) {\n  const a = i.json || {};\n  const updates = Array.isArray(a.result) ? a.result : [];\n  for (const u of updates) {\n    if (typeof u.update_id === 'number' && u.update_id >= hoechste) hoechste = u.update_id + 1;\n    const m = u.message || u.edited_message;\n    if (!m || !m.text) continue;\n    if (Number(m.chat && m.chat.id) !== CHAT_ID) continue;          // fremder Chat: uebergehen\n    const t = String(m.text).trim();\n    const tr = t.match(/^\\/e(\\d{4,12})\\b/);\n    if (!tr) continue;\n    raus.push({ json: { expose_id: tr[1], objekt_schluessel: 'is24:' + tr[1], befehl: t, message_id: m.message_id } });\n  }\n}\nfor (const r of raus) r.json.hoechste = hoechste;\nreturn raus;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        300
      ],
      "id": "a4",
      "name": "Anfragen erkennen"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "RhcS6X5MWKzfAL22",
          "mode": "list",
          "cachedResultName": "objekt",
          "cachedResultUrl": "/projects/Sbks7yJf8isk0OTm/datatables/RhcS6X5MWKzfAL22"
        },
        "returnAll": true,
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "expose_id",
              "condition": "eq",
              "keyValue": "={{ $json.expose_id }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -700,
        300
      ],
      "id": "a5",
      "name": "Objekt suchen",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// S7 Anfrage, Schritt 3: Antwort bauen.\n// Die Liste der Anfragen kommt aus \"Anfragen erkennen\", die Tabellenzeilen aus \"Objekt suchen\".\n// Kein Versand an den Makler (R20 und AGB des Portals, Ziffer 8.2). Christoph sendet selbst in der App.\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst eur = n => (typeof n === 'number') ? n.toLocaleString('de-DE') + ' EUR' : 'k. A.';\nconst zeilen = {};\nfor (const i of $input.all()) {\n  const j = i.json || {};\n  const k = String(j.expose_id || '');\n  if (k && j.titel) zeilen[k] = j;\n}\nconst raus = [];\nfor (const i of $('Anfragen erkennen').all()) {\n  const id = String((i.json || {}).expose_id || '');\n  const j = zeilen[id];\n  const url = 'https://www.immobilienscout24.de/expose/' + id;\n  if (!j) {\n    raus.push({ json: { objekt_schluessel: 'is24:' + id, expose_id: id, gefunden: false,\n      text: '<b>Objekt ' + esc(id) + ' nicht gefunden</b>\\nKeine Zeile in der Tabelle objekt.\\n' + esc(url) } });\n    continue;\n  }\n  const miete = /^A/i.test(String(j.suchauftrag || '')) ? '- Mietvertrag und aktuelle Nettokaltmiete\\n' : '';\n  const anfrage = 'Guten Tag,\\n\\nich interessiere mich fuer Ihr Angebot und bitte um das vollstaendige Exposé.\\n\\n'\n    + 'Bitte senden Sie mir dazu:\\n- Energieausweis\\n- Grundriss\\n'\n    + '- aktuelle Hoehe von Hausgeld und Instandhaltungsruecklage\\n'\n    + '- die letzten beiden Protokolle der Eigentuemerversammlung\\n' + miete\n    + '\\nVielen Dank im Voraus.\\n\\nMit freundlichen Gruessen\\nChristoph Rosenkranz';\n  const lage = [j.stadtteil, j.strasse].filter(x => x && x !== 'fehlt in der Anzeige').join(', ') || 'Lage k. A.';\n  const text = '<b>' + esc(j.titel) + '</b>\\n' + esc(lage) + ' | ' + eur(j.kaufpreis_eur)\n    + (typeof j.vorscore === 'number' ? ' | Vorscore ' + j.vorscore : '')\n    + '\\n\\n1. Anzeige oeffnen: ' + esc(url)\n    + '\\n2. Auf Nachricht schreiben tippen.'\n    + '\\n3. Text unten antippen, einfuegen, senden.\\n\\n<pre>' + esc(anfrage) + '</pre>';\n  raus.push({ json: { objekt_schluessel: j.objekt_schluessel || ('is24:' + id), expose_id: id,\n    gefunden: true, text: text, anfrage_status: 'angefragt', angefragt_am: new Date().toISOString() } });\n}\nreturn raus;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        300
